  "steps": [
    {
      "text": "Mix the detrempe to a shaggy dough. Do not develop it. Chill overnight."
    },
    {
      "text": "Beat the lamination butter into a flat pliable slab."
    },
    {
      "text": "Lock in and give three single folds, resting 45 minutes between each."
    },
    {
      "text": "Sheet to 4 mm, cut triangles, roll."
    },
    {
      "text": "Proof at 24 to 26°C until visibly jiggly."
    }
